# ============================================
# POLYMARKET / SIGNING (TRADING ASLI)
# ============================================
# Polygon EOA private key (hex, with or without 0x).
# This key signs orders. USDC.e on Polygon must be deposited to Polymarket
# (visit polymarket.com/wallet to deposit if you haven't).
PRIVATE_KEY=

# Funder address. Leave blank to default to EOA derived from PRIVATE_KEY.
# If you signed up to Polymarket via web3 wallet, this is your *proxy*
# address (different from EOA). Check polymarket.com/wallet -> "Polymarket
# Address" to see it. If signup via email, use POLY_PROXY signature_type.
POLY_FUNDER=

# Signature type:
# 0 = EOA (private key holds funds directly, advanced/uncommon)
# 1 = POLY_PROXY (email signup, default for most retail users)
# 2 = POLY_GNOSIS_SAFE (web3 wallet signup via MetaMask etc.)
SIGNATURE_TYPE=2

# ============================================
# BOT CONFIG
# ============================================
# Dry run mode: "true" = simulate trades only, "false" = real trading
DRY_RUN=true

# Market to scan (event slug from polymarket.com/event/<slug>)
MARKET_SLUG=btc-updown-5m

# Scan interval in seconds
SCAN_INTERVAL=1

# ============================================
# STRATEGY PARAMETERS
# ============================================
MIN_WALLETS=100
MIN_CONSENSUS=62
TP_PRICE=0.95
MAX_ENTRY=0.80
ENTRY_WINDOW_START=100
ENTRY_WINDOW_END=10
MAX_TRADE=6
MAX_POSITION=1
MIN_TRADE=5
